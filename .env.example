# General Project Environment Configuration

# Environment Name
NODE_ENV=development
ENVIRONMENT=development

# Database Settings (PostgreSQL + PostGIS)
POSTGRES_USER=transitpulse
POSTGRES_PASSWORD=transitpulse_secret
POSTGRES_DB=transitpulse_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://transitpulse:transitpulse_secret@localhost:5432/transitpulse_db

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Backend API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
JWT_SECRET=super_secret_jwt_key_change_in_production_32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Next.js Public Web URLs
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
